# API runtime environment reference
# Use this for direct API runs or production/container deployment

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql+psycopg://user:password@host:5432/yousum

# Optional exact origins, comma-separated. Useful for a local web app or a fixed
# Chrome extension origin once you know the installed extension ID.
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex for browser extension origins. The default in main.py keeps
# local extension development working; tighten this in production if you know
# the exact extension ID.
ALLOWED_ORIGIN_REGEX=chrome-extension://.*
