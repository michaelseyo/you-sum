# API runtime environment reference
# Use this for direct API runs or production/container deployment

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql+psycopg://user:password@host:5432/yousum
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_JWT_EXPIRES_MINUTES=60
ALLOWED_EMAILS=you@example.com,teammate@example.com
ENABLE_DEV_LOGIN=false

# Optional exact origins, comma-separated. Useful for a local web app or a fixed
# Chrome extension origin once you know the installed extension ID.
ALLOWED_ORIGINS=http://localhost:3000

# Optional regex for browser extension origins. Set this explicitly when you
# want to allow a specific extension origin.
ALLOWED_ORIGIN_REGEX=
